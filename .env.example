# Feishu app and webhook
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me
FEISHU_BOT_OPEN_ID=ou_replace_me
FEISHU_VERIFICATION_TOKEN=replace_me
FEISHU_ENCRYPT_KEY=
FEISHU_CHAT_IDS=
FEISHU_APP_SENDER_CHAT_IDS=

# Optional evidence poller
FEISHU_LIAODIAO_APP_ID=
FEISHU_LIAODIAO_CHAT_ID=

# Server-side queue and worker connection
FEISHU_CODEX_STATE_FILE=/path/to/feishu-codex/data/tasks.sqlite3
FEISHU_CODEX_SSH_TARGET=user@worker-host
FEISHU_CODEX_SSH_KEY=/path/to/feishu-codex_ed25519
FEISHU_CODEX_SSH_KNOWN_HOSTS=/path/to/known_hosts

# Worker-side Codex configuration
FEISHU_CODEX_REPO=/path/to/worker-workdir
FEISHU_CODEX_TERMINAL_REPO=/path/to/source-repo
FEISHU_CODEX_BIN=codex
FEISHU_CODEX_MODEL=gpt-6.2-sol
FEISHU_CODEX_USE_EXEC=1
FEISHU_CODEX_USE_SCREEN=0
FEISHU_CODEX_SCREEN_NAME=feishu-codex
FEISHU_CODEX_NOTIFY_CHAT_ID=
